<Window x:Class="DeepSeekTTS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeepSeek 语音合成"
        Icon="assets/logo.ico"
        Height="760" Width="900"
        MinHeight="620" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F16"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <SolidColorBrush x:Key="CardBrush" Color="#151D2B" />
        <SolidColorBrush x:Key="Card2Brush" Color="#1B2434" />
        <SolidColorBrush x:Key="LineBrush" Color="#263245" />
        <SolidColorBrush x:Key="TextBrush" Color="#E8EEF8" />
        <SolidColorBrush x:Key="MutedBrush" Color="#8B9AB1" />
        <SolidColorBrush x:Key="AccentBrush" Color="#4F7CFF" />
        <SolidColorBrush x:Key="OkBrush" Color="#35C68B" />
        <SolidColorBrush x:Key="WarnBrush" Color="#F2B544" />
        <SolidColorBrush x:Key="DangerBrush" Color="#EF5F6B" />

        <!-- 输入框 -->
        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Card2Brush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" CornerRadius="9"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalScrollBarVisibility="Auto" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 密码框 -->
        <Style x:Key="PasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Background" Value="{StaticResource Card2Brush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Bd" CornerRadius="9"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 下拉框：必须重写模板，否则默认模板会用系统白底，导致深色主题下白底白字 -->
        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" CornerRadius="9"
                                                Background="{StaticResource Card2Brush}"
                                                BorderBrush="{StaticResource LineBrush}"
                                                BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="24" />
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0"
                                                      Stroke="{StaticResource MutedBrush}" StrokeThickness="1.4"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="11,0,26,0"
                                              VerticalAlignment="Center" HorizontalAlignment="Left" />

                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom" PopupAnimation="Fade">
                                <Border Background="{StaticResource Card2Brush}"
                                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                        CornerRadius="9" Margin="0,4,0,0"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True" Margin="3" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 下拉项 -->
        <Style x:Key="ComboItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" CornerRadius="6" Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A3A55" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33456A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主按钮 -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="20,9" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="9" Background="{StaticResource AccentBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 次要按钮 -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="9"
                                Background="{StaticResource Card2Brush}"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 危险按钮 -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
        </Style>

        <!-- 卡片 -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18,16" />
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>

        <!-- 日志项 -->
        <DataTemplate x:Key="LogItemTemplate">
            <Border Background="{StaticResource Card2Brush}" CornerRadius="6"
                    Padding="9,6" Margin="0,0,0,4">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderThickness" Value="3,0,0,0" />
                        <Setter Property="BorderBrush" Value="{StaticResource MutedBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="ok">
                                <Setter Property="BorderBrush" Value="{StaticResource OkBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="warn">
                                <Setter Property="BorderBrush" Value="{StaticResource WarnBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="error">
                                <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Time}" Foreground="#5C6B82"
                               FontFamily="Consolas" FontSize="11.5" Margin="0,0,9,0" />
                    <TextBlock Text="{Binding Message}" Foreground="{StaticResource MutedBrush}"
                               FontSize="11.5" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- 顶栏 -->
            <RowDefinition Height="*" />      <!-- 主体 -->
            <RowDefinition Height="Auto" />   <!-- 日志 -->
        </Grid.RowDefinitions>

        <!-- ===== 顶栏 ===== -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10">
                <Border.Background>
                    <ImageBrush ImageSource="assets/icon-256.png" Stretch="UniformToFill" />
                </Border.Background>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="13,0,0,0">
                <TextBlock Text="DeepSeek 语音合成" Foreground="{StaticResource TextBrush}"
                           FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="文本转语音 · 整段合成" Style="{StaticResource Hint}" Margin="0,1,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="KeyBadge" CornerRadius="20" Padding="11,5" Margin="0,0,9,0"
                        Background="{StaticResource Card2Brush}"
                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="KeyDot" Width="7" Height="7" Fill="{StaticResource WarnBrush}"
                                 VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock x:Name="KeyBadgeText" Text="未配置 Key"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontFamily="Consolas" FontSize="11.5" />
                    </StackPanel>
                </Border>
                <Button x:Name="SettingsButton" Content="设置" Style="{StaticResource GhostButton}"
                        Click="SettingsButton_Click" />
            </StackPanel>
        </Grid>

        <!-- ===== 主体 ===== -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 输入区 -->
            <Border Grid.Row="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="输入文本" Style="{StaticResource CardTitle}" />
                        <TextBlock x:Name="CounterText" Text="0 / 10000 计费字符"
                                   Style="{StaticResource Hint}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" FontFamily="Consolas" />
                    </Grid>

                    <TextBox Grid.Row="1" x:Name="TextInputBox" Style="{StaticResource InputTextBoxStyle}"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             TextChanged="TextInput_TextChanged" PreviewKeyDown="TextInputBox_PreviewKeyDown" MinHeight="150" />

                    <Grid Grid.Row="2" Margin="0,13,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="音色" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="VoiceCombo" Style="{StaticResource ComboStyle}" Width="190"
                                      SelectionChanged="VoiceCombo_SelectionChanged">
                                <ComboBoxItem Style="{StaticResource ComboItemStyle}" Content="海星 · 女声（默认）" Tag="stella" IsSelected="True" />
                                <ComboBoxItem Style="{StaticResource ComboItemStyle}" Content="暗潮 · 男声" Tag="tide" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,16,0">
                            <TextBlock Text="音频格式" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="FormatCombo" Style="{StaticResource ComboStyle}" Width="235"
                                      SelectionChanged="FormatCombo_SelectionChanged">
                                <ComboBoxItem Style="{StaticResource ComboItemStyle}" Content="WAV（可直接播放）" Tag="wav" IsSelected="True" />
                                <ComboBoxItem Style="{StaticResource ComboItemStyle}" Content="PCM 裸流（24kHz/16bit/单声道）" Tag="pcm" />
                            </ComboBox>
                        </StackPanel>

                        <CheckBox Grid.Column="2" x:Name="FilterMarkdownCheck" IsChecked="True"
                                  Content="朗读前去掉 Markdown 格式"
                                  Foreground="{StaticResource MutedBrush}" FontSize="12"
                                  VerticalAlignment="Bottom" Margin="0,0,0,8"
                                  Checked="FilterMarkdownCheck_Changed"
                                  Unchecked="FilterMarkdownCheck_Changed" />

                        <TextBlock Grid.Column="3" Style="{StaticResource Hint}"
                                   Text="单次最多 10,000 计费字符" HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom" Margin="0,0,0,9" />
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,15,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" x:Name="GenerateButton" Content="生成语音"
                                Style="{StaticResource PrimaryButton}" Click="GenerateButton_Click" />

                        <Button Grid.Column="1" x:Name="CancelButton" Content="取消"
                                Style="{StaticResource GhostButton}" Margin="9,0,0,0"
                                Visibility="Collapsed" Click="CancelButton_Click" />

                        <Button Grid.Column="2" x:Name="ClearButton" Content="清空"
                                Style="{StaticResource GhostButton}" Margin="9,0,0,0"
                                HorizontalAlignment="Left" Click="ClearButton_Click" />

                        <ProgressBar Grid.Column="3" x:Name="BusyBar" Width="150" Height="4"
                                     Background="{StaticResource Card2Brush}"
                                     Foreground="{StaticResource AccentBrush}"
                                     BorderThickness="0" IsIndeterminate="True"
                                     VerticalAlignment="Center" Visibility="Collapsed" />
                    </Grid>
                </Grid>
            </Border>

            <!-- 结果区 -->
            <Border Grid.Row="1" x:Name="ResultCard" Style="{StaticResource Card}"
                    Margin="0,14,0,0" Visibility="Collapsed">
                <StackPanel>
                    <Grid Margin="0,0,0,11">
                        <TextBlock Text="生成结果" Style="{StaticResource CardTitle}" />
                        <TextBlock x:Name="ResultMeta" Style="{StaticResource Hint}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   FontFamily="Consolas" />
                    </Grid>

                    <!-- 播放控制 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" x:Name="PlayPauseButton" Style="{StaticResource GhostButton}"
                                Width="46" Padding="0,8" Click="PlayPauseButton_Click" ToolTip="播放 / 暂停">
                            <TextBlock x:Name="PlayIcon" Text="▶" FontSize="14" />
                        </Button>

                        <Slider Grid.Column="1" x:Name="SeekSlider" Margin="13,0,13,0"
                                VerticalAlignment="Center" IsMoveToPointEnabled="True"
                                Minimum="0" Maximum="1" Value="0"
                                ValueChanged="SeekSlider_ValueChanged"
                                Thumb.DragStarted="SeekSlider_DragStarted"
                                Thumb.DragCompleted="SeekSlider_DragCompleted" />

                        <TextBlock Grid.Column="2" x:Name="TimeText" Text="00:00 / 00:00"
                                   Foreground="{StaticResource MutedBrush}" FontFamily="Consolas"
                                   FontSize="11.5" VerticalAlignment="Center" Margin="0,0,14,0" />

                        <Button Grid.Column="3" x:Name="DownloadButton" Content="下载"
                                Style="{StaticResource PrimaryButton}" Click="DownloadButton_Click" />
                    </Grid>

                    <TextBlock x:Name="PcmNote" Style="{StaticResource Hint}" Margin="0,10,0,0"
                               TextWrapping="Wrap" Visibility="Collapsed"
                               Foreground="{StaticResource WarnBrush}"
                               Text="PCM 为不含容器头的原始数据，已在本机内存中临时套上 WAV 头供试听；下载的文件仍是官方原始 PCM 裸流，未做任何转换。" />

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="DiscardButton" Content="删除临时文件"
                                Style="{StaticResource DangerButton}" Click="DiscardButton_Click" />
                        <TextBlock x:Name="TempPathText" Style="{StaticResource Hint}"
                                   VerticalAlignment="Center" Margin="14,0,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== 日志 ===== -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="18,13">
            <StackPanel>
                <Grid Margin="0,0,0,9">
                    <TextBlock Text="运行日志" Style="{StaticResource CardTitle}" />
                    <Button Content="清空" Style="{StaticResource GhostButton}" Padding="10,3"
                            FontSize="11" HorizontalAlignment="Right" Click="ClearLog_Click" />
                </Grid>
                <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="LogList" ItemTemplate="{StaticResource LogItemTemplate}" />
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Grid>
</Window>
